      "source": [
        "def binarySearch(arr, l, r, x):\n",
        "    if r >= l:\n",
        "        mid = l + (r - l) // 2\n",
        "        midd = int(mid)\n",
        "        if arr[midd] == x:\n",
        "            return midd\n",
        "        elif arr[midd] > x:\n",
        "            return binarySearch(arr, l, midd - 1, x)\n",
        "        else:\n",
        "            return binarySearch(arr, midd + 1, r, x)\n",
        "    return -1\n",
        "\n",
        "arr = [2, 3, 4, 10, 40]\n",
        "x = 10\n",
        "result = binarySearch(arr, 0, len(arr) - 1, x)\n",
        "if result != -1:\n",
        "    print(\"Element is present at index %d\" % result)\n",
        "else:\n",
        "    print(\"Element is not present in array\")"
